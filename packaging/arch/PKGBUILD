# Maintainer: Rufust contributors
pkgname=rufust
pkgver=1.2.1
pkgrel=1
pkgdesc="Format and create bootable USB drives (Linux port inspired by Rufus)"
arch=('x86_64' 'aarch64')
conflicts=('rufus-linux')
replaces=('rufus-linux')
url="https://github.com/NitroDiesel/rufust"
license=('GPL-3.0-or-later')
depends=('udisks2' 'polkit' 'util-linux' 'parted' 'dosfstools' 'exfatprogs' 'ntfsprogs'
         'e2fsprogs' 'udftools' 'qemu-img' 'libnbd' 'fontconfig' 'freetype2'
         'libxkbcommon' 'libxkbcommon-x11' 'libxcursor' 'libxi' 'libglvnd'
         'wayland' 'libx11' 'libxcb')
optdepends=(
  'gzip: gzip and Unix compress image support'
  'bzip2: bzip2 image support'
  'xz: xz/lzma image support'
  'zstd: zstd image support'
  'libarchive: zip image support'
)
makedepends=('cargo' 'rust' 'base-devel')
# Release automation replaces the checksum when publishing a signed tag.
source=("$pkgname-$pkgver.tar.gz::https://github.com/NitroDiesel/rufust/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/rufust "$pkgdir/usr/bin/rufust"
  install -Dm755 target/release/rufust-helper "$pkgdir/usr/libexec/rufust-helper"
  install -Dm644 packaging/desktop/io.github.nitrodiesel.rufust.desktop \
    "$pkgdir/usr/share/applications/io.github.nitrodiesel.rufust.desktop"
  install -Dm644 packaging/metainfo/io.github.nitrodiesel.rufust.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.nitrodiesel.rufust.metainfo.xml"
  install -Dm644 packaging/polkit/io.github.nitrodiesel.rufust.policy \
    "$pkgdir/usr/share/polkit-1/actions/io.github.nitrodiesel.rufust.policy"
  install -Dm644 packaging/tmpfiles/rufust.conf \
    "$pkgdir/usr/lib/tmpfiles.d/rufust.conf"
  local size
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "assets/icons/rufust-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/io.github.nitrodiesel.rufust.png"
  done
  install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
  install -Dm644 assets/icons/LICENSE.txt \
    "$pkgdir/usr/share/licenses/$pkgname/ICON-LICENSE.txt"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
